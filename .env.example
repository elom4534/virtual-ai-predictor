# === GLOBAL ===
NODE_ENV=development
POSTGRES_DB=preddb
POSTGRES_USER=preduser
POSTGRES_PASSWORD=predpass_change_me
DATABASE_URL=postgres://preduser:predpass_change_me@localhost:5432/preddb
REDIS_URL=redis://localhost:6379

# === SECRETS — À RENSEIGNER LOCALEMENT (jamais commité) ===
# Copier ce fichier en .env et remplir. En prod: Vault / Secrets Manager.
JWT_SECRET=CHANGE_ME_64_CHARS_RANDOM

# --- Live Football API (https://live-football-api.com — 3 clés avec rotation, 499 crédits restants sur 2/3) ---
# Usage: GET https://live-football-api.com/api/v1/matches?api_key=KEY&date=YYYY-MM-DD
LIVE_FOOTBALL_API_KEY=
LIVE_FOOTBALL_API_KEY_2=
LIVE_FOOTBALL_API_KEY_3=
LIVE_FOOTBALL_BASE_URL=https://live-football-api.com

# --- 1xBet (docs-marketing-sport.com — Marketing API BetB2B) ---
XBET_CLIENT_ID=partners-592d3a39b56e7ca211a846129d6fc5e3
XBET_CLIENT_SECRET=
XBET_REF=1
XBET_LOGIN=marketingsport
XBET_PASSWORD=

# --- Méga Pari (même doc, ref différent) ---
MEGAPARI_CLIENT_ID=partners-c2b75a07c454fcd96f0453a0f79e1ead
# ⚠️ Le secret fourni par le bookmaker arrive avec les entités HTML `&amp;`.
#    Envoyé tel quel → {"error":"invalid_client"} (HTTP 400).
#    Le code décode automatiquement (`&amp;` → `&`) : coller la valeur brute ici.
MEGAPARI_CLIENT_SECRET=
MEGAPARI_REF=192

# --- Commun Bookmaker (gateway BetB2B — vérifié en production) ---
BOOKMAKER_API_BASE=https://cpservm.com/gateway/marketing
BOOKMAKER_TOKEN_URL=https://cpservm.com/gateway/token
BOOKMAKER_CREATE_COUPON_PATH=/coupon/create
# Rate limits officiels : 1 req / 5 s (live), 1 req / 20 s (lines)
BOOKMAKER_PAUSE_LIVE=5
BOOKMAKER_PAUSE_LINE=20
BOOKMAKER_ETL_LIMIT=25
# Fallbacks legacy (compat)
BOOKMAKER_CLIENT_ID=
BOOKMAKER_CLIENT_SECRET=
BOOKMAKER_REF=
BOOKMAKER_API_KEY=
BOOKMAKER_BASE_URL=https://api.marketing-sport.com

# === OBJECT STORAGE ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123_change_me
MINIO_ENDPOINT=localhost
MINIO_BUCKET_MODELS=pred-models
MINIO_BUCKET_DATASETS=pred-datasets

# === COUNTRY POLICY ===
ALLOWED_COUNTRIES=CI,CM,FR,BE,MA,SN,TG,BJ,ML,BF,NE,GN,GA,CG,CD,RW,KE,NG,GH,ZA
BLOCKED_COUNTRIES=US,GB,DE
# Le pays doit venir du JWT (req.user.country_code).
# Le header X-Country-Code est contrôle par le client → spoofable :
# il n'est accepté que si ce flag est à true (mode démo, avant l'auth).
# En production : false (fail-closed).
ALLOW_COUNTRY_HEADER_FALLBACK=false

# === CIRCUIT BREAKER (spec §14) ===
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

# === TRAINING (time split as-of) ===
# TRAIN_AS_OF=2026-10-01T00:00:00

# === APP ===
API_PORT=3000
ML_PORT=8000
FRONTEND_BASE_URL=http://localhost:5173

# === FEATURE FLAGS ===
ENABLE_VIRTUAL=true
ENABLE_MIX_COUPONS=true
MAX_COUPON_SELECTIONS=10
DEFAULT_MARGIN_THRESHOLD=5.0
